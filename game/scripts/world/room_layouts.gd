## Layout names for a room: small early, larger later, harder as the run goes on.
static func pool(step: int) -> Array:
	var sizes: Array = ["S"] if step <= 2 else (["S", "M"] if step <= 3 else (["M"] if step <= 6 else ["M", "L"]))
	var diffs: Array = ["easy"] if step <= 1 else (["easy", "medium"] if step <= 3 else ["medium", "hard"])
	var out: Array = []
	for k in ART:
		if sizes.has(ART[k]["size"]) and diffs.has(ART[k]["diff"]):
			out.append(k)
	return out
