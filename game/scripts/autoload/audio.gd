## A cue compiled from its table row, with its files, and the request gathered this frame.
class Cue:
	var id := ""
	var cls := "cmb"
	var bus := "SFX"
	var prio := 50
	var group := ""
	var cap := 2
	var gap := 0.03
	var gain_db := 0.0
	var cents := 25.0
	var vol := 1.0
	var pan := true
	var walk := ""
	var walk_win := 0.6
	var walk_reset := 0.8
	var walk_max := 5
	var semis0 := 0.0
	var reserved := false
	var streams: Array[AudioStream] = []
	var lengths := PackedFloat32Array()
	var heavy_idx := -1     # casts: the Heavy/Empower variant (_heavy), never picked at random
	var last_pick := -1
	var last_t := -99.0     # when it last started (s)
	# this frame's request (repeats merge into it)
	var n := 0
	var at := Vector2.INF
	var db := 0.0
	var semis := 0.0
	var from := 0.0
	var force := -1


## One pool voice: a panned player (crit, cmb, det) or a centred one (ui).
class Voice:
	var p: AudioStreamPlayer
	var p2: AudioStreamPlayer2D
	var cue: Cue
	var prio := 0
	var db := 0.0
	var t0 := 0             # msec it started
	var t1 := 0             # msec it ends
	var held_left := -1     # msec left while a telegraph is held by hit-stop or a menu

	func busy(now: int) -> bool:
		return cue != null and (now < t1 or held_left >= 0)

	func stop() -> void:
		if p2:
			p2.stop()
			p2.stream_paused = false
		else:
			p.stop()
		cue = null
		t1 = 0
		held_left = -1


## The music dips under the Duck's and LINT's voices (Dialogue sets this, in dB).
var voice_db := 0.0
var sound_on := true
var music_on := true
var heartbeat_on := true
var _cues: Dictionary = {}          # id -> Cue
var _queue: Array[Cue] = []
var _later: Array[Dictionary] = []  # requests that wait a few ms (a second cast timbre, babble)
var _walks: Dictionary = {}         # group -> Vector2(step, time of the last walked request)
var _soft := ""                     # a default menu sound, dropped if the handler plays its own
var _firm_centred := false
var _pools: Dictionary = {}         # class -> Array[Voice]
var _budget := BUDGET_NATIVE
var _rng := RandomNumberGenerator.new()
var _by_prio := func(a: Cue, b: Cue) -> bool: return a.prio > b.prio or (a.prio == b.prio and a.db > b.db)
var _streams: Dictionary = {}
var _buses_built := false
var _loops: Dictionary = {}         # id -> AudioStreamPlayer2D


func _ready() -> void:
	_setup()


## Creates buses and players once (lazily too: headless test runs call sfx() before _ready).
func _setup() -> void:
	if not _pools.is_empty():
		return
	process_mode = Node.PROCESS_MODE_ALWAYS
	process_priority = 1000    # flush after everything else has asked for its sounds this frame
	_budget = BUDGET_WEB if OS.has_feature("web") else BUDGET_NATIVE
	_buses()
	for c: String in VOICES:
		var arr: Array[Voice] = []
		for i in int(VOICES[c]):
			var v := Voice.new()
			if c == "ui":
				v.p = AudioStreamPlayer.new()
				v.p.bus = CLASS_BUS[c]
				add_child(v.p)
			else:
				v.p2 = _player_2d(CLASS_BUS[c], PAN_STRENGTH, c != "crit")
				add_child(v.p2)
			arr.append(v)
		_pools[c] = arr
	_music_a = AudioStreamPlayer.new()
	_music_b = AudioStreamPlayer.new()
	for m in [_music_a, _music_b]:
		m.bus = "Music"
		m.volume_db = -80.0
		add_child(m)
	for k in 2:
		var s := AudioStreamPlayer.new()
		s.bus = "Sting"
		add_child(s)
		_stings.append(s)
		_sting_prio.append(0)
	_spot = _player_2d("Ambience", 2.0, false)
	add_child(_spot)
	Events.player_hurt.connect(func(_a: float) -> void: sfx("hurt"))
	Events.room_cleared.connect(_on_room_cleared)
	Events.boss_defeated.connect(func() -> void: sfx("bigboom"))
	apply(Game.settings())


func _player_2d(bus: String, strength: float, attenuate: bool) -> AudioStreamPlayer2D:
	var p := AudioStreamPlayer2D.new()
	p.bus = bus
	p.panning_strength = strength
	p.max_distance = PAN_DISTANCE if attenuate else 100000.0
	p.attenuation = PAN_ATTENUATION if attenuate else 0.0
	p.area_mask = 0              # no Area2D reverb lookups
	return p


## The bus layout above. Built once; a bus only sends to one before it.
func _buses() -> void:
	if _buses_built:
		return
	_buses_built = true
	_ensure_bus("SFX", "Master")
	_ensure_bus("Glitch", "SFX")
	_ensure_bus("Music", "Master")
	_ensure_bus("Critical", "Master")
	_ensure_bus("Sting", "Master")
	_ensure_bus("UI", "Master")
	_ensure_bus("Ambience", "Master")
	var master := _clear_effects("Master")
	var lim := AudioEffectHardLimiter.new()
	lim.ceiling_db = -1.0
	lim.release = 0.1
	AudioServer.add_bus_effect(master, lim)
	var music := _clear_effects("Music")
	var duck := AudioEffectCompressor.new()
	duck.sidechain = &"Critical"
	duck.threshold = -24.0
	duck.ratio = 3.0
	duck.attack_us = 5000.0
	duck.release_ms = 300.0
	AudioServer.add_bus_effect(music, duck)
	_lowpass = AudioEffectLowPassFilter.new()
	_lowpass.cutoff_hz = 20000.0
	AudioServer.add_bus_effect(music, _lowpass, 1)
	AudioServer.set_bus_effect_enabled(music, 1, false)
	var sfx_bus := _clear_effects("SFX")
	var chatter := AudioEffectCompressor.new()
	chatter.sidechain = &"Critical"
	chatter.threshold = -30.0
	chatter.ratio = 2.5
	chatter.attack_us = 2000.0
	chatter.release_ms = 180.0
	AudioServer.add_bus_effect(sfx_bus, chatter)
	var glitch := _clear_effects("Glitch")
	var lofi := AudioEffectDistortion.new()
	lofi.mode = AudioEffectDistortion.MODE_LOFI
	AudioServer.add_bus_effect(glitch, lofi, 0)
	AudioServer.set_bus_effect_enabled(glitch, 0, false)


func _ensure_bus(name: String, send: String) -> void:
	var i := AudioServer.get_bus_index(name)
	if i < 0:
		AudioServer.add_bus()
		i = AudioServer.bus_count - 1
		AudioServer.set_bus_name(i, name)
	AudioServer.set_bus_send(i, send)


func _clear_effects(name: String) -> int:
	var i := AudioServer.get_bus_index(name)
	while AudioServer.get_bus_effect_count(i) > 0:
		AudioServer.remove_bus_effect(i, 0)
	return i


## The bus effects that are running now (the web-cost DOG: at most 3 when nothing special is on).
func active_effects() -> int:
	var n := 0
	for b in AudioServer.bus_count:
		for e in AudioServer.get_bus_effect_count(b):
			if AudioServer.is_bus_effect_enabled(b, e):
				n += 1
	return n


func apply(settings: Dictionary) -> void:
	# Game applies saved settings before this node's _ready: make sure the buses exist
	_buses()
	sound_on = bool(settings.get("sound", true))
	music_on = bool(settings.get("music", true))
	heartbeat_on = bool(settings.get("heartbeat", true))
	for b in ["SFX", "Critical", "UI", "Ambience"]:
		AudioServer.set_bus_mute(AudioServer.get_bus_index(b), not sound_on)
	for b in ["Music", "Sting"]:
		AudioServer.set_bus_mute(AudioServer.get_bus_index(b), not music_on)
	if not sound_on:
		_stop_voices(["crit", "cmb", "ui", "det"])
		_later.clear()
		for id: String in _loops:
			(_loops[id] as AudioStreamPlayer2D).stop()
	if not music_on:
		for s: AudioStreamPlayer in _stings:
			s.stop()


# ------------------------------------------------------------------ one-shots

## Asks for a sound effect. `at` is where it happened in the world (it pans); `gain_db` is added
## to the cue's own gain (context only, such as a second timbre); `step` is the walk index for
## "slot", "depth" and "count" cues.
func sfx(id: String, at := Vector2.INF, gain_db := 0.0, step := 0) -> void:
	_request(id, at, gain_db, step, 0.0, 0.0, -1)


## A default menu sound (a button press, a screen opening or closing). It plays only if nothing
## else centred was asked for in the same frame, and only the first of them per frame.
func ui(id: String) -> void:
	if not sound_on or Game.quiet > 0:
		return
	if _soft == "":
		_soft = id


## The cast sound of a spell id.
static func cast_name(spell_id: StringName) -> String:
	return CAST.get(spell_id, "cast_spark")


## A wand cast (sound-v2 §4.2): the first spell's timbre, walked by its wand slot, raised by
## 2·log2(spells) dB (at most 3); a second, different timbre 20 ms later at -4 dB; the "heavy"
## variant when the cast carries Heavy or Empower.
func cast_plan(spell_ids: Array[StringName], at: Vector2, slot: int, heavy := false) -> void:
	if spell_ids.is_empty() or not sound_on or Game.quiet > 0:
		return
	var first := spell_ids[0]
	var name := cast_name(first)
	var off: Array = CAST_OFFSET.get(first, [0.0, 0.0])
	var gain := minf(3.0, 2.0 * log(float(spell_ids.size())) / log(2.0)) + float(off[1])
	var c := _cue(name)
	_request(name, at, gain, slot, float(off[0]), 0.0, c.heavy_idx if heavy else -1)
	for id in spell_ids:
		var second := cast_name(id)
		if second != name:
			var off2: Array = CAST_OFFSET.get(id, [0.0, 0.0])
			_later.append({"ms": Time.get_ticks_msec() + 20, "id": second, "at": at, "db": -4.0 + float(off2[1]),
				"step": slot, "semis": float(off2[0])})
			break


## One spell's cast sound (a copy or a familiar asks through its own cue; see DERIVED).
func cast(spell_id: StringName, at := Vector2.INF, slot := 0) -> void:
	var ids: Array[StringName] = [spell_id]
	cast_plan(ids, at, slot)


## A familiar fires (sound-v2 §4.2 familiar_shot): its payload's cast, 6 dB down.
func familiar_shot(spell_id: StringName, at: Vector2) -> void:
	_request("fam:" + cast_name(spell_id), at, 0.0, 0, 0.0, 0.0, -1)


## A hit on an enemy: the element's hit, with the crit and the heavy body as sweeteners on it.
func hit(id: String, at: Vector2, crit: bool, heavy: bool) -> void:
	_request(id, at, 0.0, 0, 0.0, 0.0, -1)
	if crit:
		_request("crit", at, 0.0, 0, 0.0, 0.0, -1)
	if heavy:
		_request("hit_heavy", at, 0.0, 0, 0.0, 0.0, -1)


## An enemy dies: size 0 fodder, 1 heavy, 2 elite; `how` (&"burn" | &"frost" | &"static") picks
## the way it died, for fodder.
func kill(_kind: StringName, at: Vector2, size: int, how := &"") -> void:
	var id := "kill_big" if size >= 2 else ("kill_mid" if size == 1 else String(KILL_BY.get(how, "kill")))
	_request(id, at, 0.0, 0, 0.0, 0.0, -1)


## An enemy shot leaves: `sound` from the shooter, `by` its source tag. Still hazards get one
## cue for the whole thing (thorns, trash, a box fill) or none; your copied spells sound like
## your spells, glitched.
func enemy_shot(sound: String, by: String, at: Vector2) -> void:
	if by.begins_with("copy:"):
		_request("copy:" + cast_name(StringName(by.substr(5))), at, 0.0, 0, 0.0, 0.0, -1)
		return
	for pre: String in SHOT_PREFIX:
		if by.begins_with(pre):
			var id: String = SHOT_PREFIX[pre]
			if id != "":
				_request("thorns_spark" if id == "thorns" and by.ends_with("spark_plug") else id, at, 0.0, 0, 0.0, 0.0, -1)
			return
	_request(sound, at, 0.0, 0, 0.0, 0.0, -1)


## The hit sound a spell's element makes.
static func hit_for(spell_id: StringName) -> String:
	var h: Variant = _hit_cache.get(spell_id)
	if h == null:
		h = HIT.get(CAST.get(spell_id, ""), "hit")
		_hit_cache[spell_id] = h
	return h


static var _hit_cache := {}


## The hit a bullet makes: its coat's element when it has one (rot > static > chill > burn,
## the rarer mechanic announced), else its spell's.
static func hit_for_bullet(spell_id: StringName, burn: int, chill: int, static_on: bool, rot: int) -> String:
	if rot > 0:
		return "hit_rot"
	if static_on:
		return "hit_static"
	if chill > 0:
		return "hit_ice"
	if burn > 0:
		return "hit_fire"
	return hit_for(spell_id)


## A telegraph that ends on the frame its attack releases (sound-v2 §4.6, §4.7.1): call it every
## tick of the wind-up with the time left now and a tick ago (INF on the first tick). The cue
## starts once no more than its file's length is left, from the offset that makes it end when
## the time runs out. World time, so a hit-stop or a menu holds it too.
func tele_tick(id: String, left: float, prev_left: float, at: Vector2) -> void:
	var off := tele_offset(id, left, prev_left)
	if off >= 0.0:
		_request(id, at, 0.0, 0, 0.0, off, -1)


## Where in its file a telegraph starts this tick (-1: not this tick).
func tele_offset(id: String, left: float, prev_left: float) -> float:
	var c := _cue(id)
	if c.streams.is_empty() or left < 0.0:
		return -1.0
	var ln := c.lengths[0]
	if prev_left > ln and left <= ln:
		return ln - left
	return -1.0


static func tele_for_ai(ai: StringName, panicked := false) -> String:
	return "tele_charge" if panicked else String(TELE_BY_AI.get(ai, "tele"))


static func tele_for_move(move: StringName) -> String:
	return String(TELE_BY_MOVE.get(move, "tele_boss"))


## The Duck talks (sound-v2 §4.10): one babble syllable per 2-3 characters of the line.
func babble(text: String, who := "duck") -> void:
	if not sound_on or Game.quiet > 0:
		return
	var n := clampi(roundi(text.length() / 2.5), 1, 24)
	var now := Time.get_ticks_msec()
	var id := "glitch_say" if who != "duck" else "duck_say"
	for k in n:
		_later.append({"ms": now + k * 80, "id": id, "at": Vector2.INF, "db": 0.0, "step": 0,
			"semis": 0.0 if who != "duck" else _rng.randf_range(-2.0, 2.0)})


## The voice class of a cue ("crit" | "cmb" | "ui" | "det").
static func voice_class(id: String) -> String:
	return String(_row(id)["class"])


## A cue's full row: its table row over its group, its class and the defaults.
static func _row(id: String) -> Dictionary:
	var row: Dictionary = CUES.get(id, {})
	for pre: String in DERIVED:
		if id.begins_with(pre):
			row = DERIVED[pre]
	var grp: Dictionary = GROUPS.get(String(row.get("group", "")), {})
	var cls := String(row.get("class", grp.get("class", "cmb")))
	return CUE_DEFAULT.merged(CLASSES.get(cls, {}), true).merged(grp, true).merged(row, true).merged({"class": cls}, true)


func _request(id: String, at: Vector2, gain_db: float, step: int, semis: float, from: float, force: int) -> void:
	if not sound_on or Game.quiet > 0:
		return
	var c: Cue = _cues.get(id)
	if c == null:
		c = _cue(id)
	if c.walk != "":
		semis += _walk(c, step)
	if c.n == 0:
		_queue.append(c)
		c.at = at
		c.db = gain_db
		c.semis = semis
		c.from = from
		c.force = force
	else:
		if gain_db > c.db:
			c.db = gain_db
			c.at = at
		c.semis = maxf(c.semis, semis)
	c.n += 1
	if at == Vector2.INF:
		_firm_centred = true


## The walk's pitch in semitones for this request.
func _walk(c: Cue, step: int) -> float:
	var key := float(KEY.get(_track, 0))
	match c.walk:
		"chain":
			var t := Time.get_ticks_msec() / 1000.0
			var w: Vector2 = _walks.get(c.group, Vector2(-1.0, -99.0))
			var k := 0
			if t - w.y <= c.walk_win:
				k = mini(int(w.x) + 1, c.walk_max)
			elif t - w.y <= c.walk_reset:
				k = maxi(0, int(w.x))
			_walks[c.group] = Vector2(k, t)
			return key + float(SCALE[mini(k, SCALE.size() - 1)])
		"slot":
			return key + float(SCALE[posmod(step, 5)])
		"depth":
			return key + float(DEPTH_STEPS[clampi(step, 0, DEPTH_STEPS.size() - 1)])
		"count":
			return key + float(COUNT_STEPS[posmod(step, COUNT_STEPS.size())])
	return 0.0


## Compiles a cue from its row (and loads its files) the first time it is asked for.
func _cue(id: String) -> Cue:
	var c: Cue = _cues.get(id)
	if c:
		return c
	c = Cue.new()
	c.id = id
	var d := _row(id)
	c.cls = String(d["class"]) if VOICES.has(String(d["class"])) else "cmb"
	c.bus = String(d["bus"]) if String(d["bus"]) != "" else String(CLASS_BUS[c.cls])
	c.prio = int(d["prio"])
	c.group = String(d["group"]) if String(d["group"]) != "" else id
	c.cap = maxi(1, int(d["cap"]))
	c.gap = float(d["gap"])
	c.gain_db = float(d["gain_db"])
	c.cents = float(d["jitter_cents"])
	c.vol = float(d["vol_db"])
	c.pan = bool(d["pan"])
	c.walk = String(d["walk"])
	c.walk_win = float(d["walk_win"])
	c.walk_reset = float(d["walk_reset"])
	c.walk_max = int(d["walk_max"])
	c.semis0 = float(d["semis"])
	c.reserved = id in RESERVED
	var file := id
	for pre: String in DERIVED:
		if id.begins_with(pre):
			file = id.substr(pre.length())
	_load_files(c, file)
	if c.streams.is_empty() and String(d["fallback"]) != "":
		var fb := _cue(String(d["fallback"]))
		c.streams = fb.streams
		c.lengths = fb.lengths
		c.heavy_idx = fb.heavy_idx
	_cues[id] = c
	return c


func _load_files(c: Cue, file: String) -> void:
	var path := "res://assets/audio/sfx_%s.wav" % file
	var k := 1
	while ResourceLoader.exists(path):
		var s: AudioStream = load(path)
		if s:
			c.streams.append(s)
			c.lengths.append(s.get_length())
		k += 1
		path = "res://assets/audio/sfx_%s_%d.wav" % [file, k]
	# a cast's Heavy/Empower variant (sfx_<id>_heavy.wav) goes last and is never picked at random
	path = "res://assets/audio/sfx_%s_heavy.wav" % file
	if c.group == "cast" and ResourceLoader.exists(path) and not c.streams.is_empty():
		var h: AudioStream = load(path)
		if h:
			c.heavy_idx = c.streams.size()
			c.streams.append(h)
			c.lengths.append(h.get_length())


## Starts this frame's sounds: repeats merged, highest priority first, at most the budget of
## new voices (moments are never refused). Returns how many started. Called once a frame.
func flush() -> int:
	if not _later.is_empty():
		var ms := Time.get_ticks_msec()
		var i := 0
		while i < _later.size():
			var r: Dictionary = _later[i]
			if int(r["ms"]) <= ms:
				_later.remove_at(i)
				_request(r["id"], r["at"], r["db"], r["step"], r["semis"], 0.0, -1)
			else:
				i += 1
	if _soft != "":
		if not _firm_centred:
			_request(_soft, Vector2.INF, 0.0, 0, 0.0, 0.0, -1)
		_soft = ""
	_firm_centred = false
	if _queue.is_empty():
		return 0
	_setup()
	var now := Time.get_ticks_msec()
	var t := now / 1000.0
	if _queue.size() > 1:
		_queue.sort_custom(_by_prio)
	var ear := _ear()
	var live := is_inside_tree()   # headless tests run before the tree is up: bookkeeping only
	var started := 0
	for c in _queue:
		var n := c.n
		c.n = 0
		if c.streams.is_empty() or t - c.last_t < c.gap:
			continue
		if started >= _budget and c.prio < BUDGET_EXEMPT:
			continue
		var v := _voice_for(c, now)
		if v == null:
			continue
		c.last_t = t
		_start(v, c, n, now, ear, live)
		started += 1
	_queue.clear()
	return started


## A voice for the cue. Its group at its cap: the group's weakest voice. Else a free voice; else
## the weakest voice that does not outrank it (lowest prio, then quietest, then least time
## left); else none. The last Critical voice is only for the RESERVED cues.
func _voice_for(c: Cue, now: int) -> Voice:
	var pool: Array[Voice] = _pools[c.cls]
	var n := pool.size() - (1 if c.cls == "crit" and not c.reserved else 0)
	var in_group := 0
	var weakest: Voice = null
	for i in n:
		var v := pool[i]
		if v.busy(now) and v.cue.group == c.group:
			in_group += 1
			if weakest == null or _weaker(v, weakest):
				weakest = v
	if in_group >= c.cap:
		return weakest
	var victim: Voice = null
	for i in n:
		var v := pool[i]
		if not v.busy(now):
			return v
		if v.prio <= c.prio and (victim == null or _weaker(v, victim)):
			victim = v
	return victim


static func _weaker(a: Voice, b: Voice) -> bool:
	if a.prio != b.prio:
		return a.prio < b.prio
	if absf(a.db - b.db) > 0.5:
		return a.db < b.db
	return a.t1 < b.t1


func _start(v: Voice, c: Cue, n: int, now: int, ear: Vector2, live := true) -> void:
	var k := c.force if c.force >= 0 and c.force < c.streams.size() else _pick(c)
	var cents := _rng.randf_range(-c.cents, c.cents) if c.cents > 0.0 else 0.0
	var pitch := pow(2.0, (c.semis0 + c.semis + cents / 100.0) / 12.0)
	var db := c.gain_db + c.db + minf(MERGE_MAX_DB, 10.0 * log(float(n)) / log(10.0))
	if c.vol > 0.0:
		db += _rng.randf_range(-c.vol, c.vol)
	var from := clampf(c.from, 0.0, c.lengths[k])
	if v.cue:
		v.stop()
	v.cue = c
	v.prio = c.prio
	v.db = db
	v.t0 = now
	v.t1 = now + int((c.lengths[k] - from) / pitch * 1000.0) + 20
	if not live:
		return
	if v.p2:
		v.p2.stream = c.streams[k]
		v.p2.bus = c.bus
		v.p2.global_position = c.at if c.pan and c.at != Vector2.INF else ear
		v.p2.pitch_scale = pitch
		v.p2.volume_db = db
		v.p2.play(from)
	else:
		v.p.stream = c.streams[k]
		v.p.volume_db = db
		v.p.pitch_scale = pitch
		v.p.play(from)
		v.p.pitch_scale = pitch   # godot #95850 (web): set it again once playing
	if c.bus == "Glitch":
		_glitch_until = maxi(_glitch_until, v.t1)


## A variant, never the one that played last (and never a cast's Heavy variant at random).
func _pick(c: Cue) -> int:
	var n := c.streams.size() - (1 if c.heavy_idx >= 0 else 0)
	if n <= 1:
		return 0
	var k := _rng.randi_range(0, n - 1) if c.last_pick < 0 or c.last_pick >= n else _rng.randi_range(0, n - 2)
	if c.last_pick >= 0 and c.last_pick < n and k >= c.last_pick:
		k += 1
	c.last_pick = k
	return k


## Where the listener is: the middle of the screen, in world coordinates.
func _ear() -> Vector2:
	var vp := get_viewport()
	if vp == null:
		return Vector2.ZERO
	return (vp.get_global_canvas_transform() * vp.get_canvas_transform()).affine_inverse() * (vp.get_visible_rect().size * 0.5)


func _stop_voices(classes: Array) -> void:
	for c: String in classes:
		if _pools.has(c):
			for v: Voice in _pools[c]:
				if v.cue:
					v.stop()


## A room change: world sounds, loops and anything still waiting stop (the UI keeps playing).
func stop_world() -> void:
	for c in _queue:
		c.n = 0
	_queue.clear()
	_later.assign(_later.filter(func(r: Dictionary) -> bool: return String(r["id"]).ends_with("_say")))
	_stop_voices(["crit", "cmb", "det"])
	loops_off()
	_tele_hold_until = 0


## Tests: forget every gap, walk and voice.
func reset() -> void:
	stop_world()
	_stop_voices(["ui"])
	_later.clear()
	_walks.clear()
	_soft = ""
	_firm_centred = false
	for id: String in _cues:
		var c: Cue = _cues[id]
		c.last_t = -99.0
		c.last_pick = -1


## The cue ids of a class's voices playing now (tests).
func voices_busy(cls: String) -> Array[String]:
	var out: Array[String] = []
	var now := Time.get_ticks_msec()
	for v: Voice in _pools.get(cls, []):
		if v.busy(now):
			out.append(v.cue.id)
	return out


## A world loop (the Deadlock beam, the Loop's trail): on starts or moves it, off stops it.
## `pitch` (the beam turns faster in phase 2) is set after play() (godot #95850).
func loop(id: String, on: bool, at := Vector2.INF, pitch := 1.0) -> void:
	var p: AudioStreamPlayer2D = _loops.get(id)
	if not on:
		if p and p.playing:
			p.stop()
		return
	if not sound_on or Game.quiet > 0 or not is_inside_tree():
		return
	if p == null:
		var c := _cue(id)
		if c.streams.is_empty():
			return
		var s := c.streams[0]
		if s is AudioStreamWAV and (s as AudioStreamWAV).loop_mode == AudioStreamWAV.LOOP_DISABLED:
			var w := (s as AudioStreamWAV).duplicate() as AudioStreamWAV
			w.loop_mode = AudioStreamWAV.LOOP_FORWARD
			w.loop_begin = 0
			w.loop_end = int(w.get_length() * w.mix_rate)
			s = w
		p = _player_2d(c.bus, float(LOOP_PAN.get(id, PAN_STRENGTH)), false)
		p.stream = s
		p.volume_db = c.gain_db
		add_child(p)
		_loops[id] = p
	p.global_position = at if at != Vector2.INF else _ear()
	if not p.playing:
		p.play()
	if p.pitch_scale != pitch:
		p.pitch_scale = pitch


func loops_off() -> void:
	for id: String in _loops:
		(_loops[id] as AudioStreamPlayer2D).stop()


func loop_playing(id: String) -> bool:
	return _loops.has(id) and (_loops[id] as AudioStreamPlayer2D).playing


# ------------------------------------------------------------------ state: snapshots, low HP, hit-stop

var _snap := &"play"
var _low := false
var _lowpass: AudioEffectLowPassFilter
var _lp_hz := 20000.0
var _snap_music_db := 0.0
var _snap_amb_db := 0.0
var _snap_tw: Tween
var _applied := Vector4(-1.0, -1.0, -1.0, -1.0)   # low-pass, music, ambience, SFX last written
var _hp_frac := 1.0
var _hp_seen := -99999
var _hb_t := 0.0
var _duck_until := 0
var _duck_db := 0.0
var _tele_hold_until := 0
var _tele_held := false
var _glitch_until := 0
var _glitch_on := false


## The mix state (sound-v2 §5.2): &"play" | &"menu" (also &"pause", &"editor", &"map",
## &"reward", &"shop") | &"dead".
##   menu  the music closes to 1.2 kHz and drops 4 dB, the ambience 8 dB; telegraphs hold
##   dead  the music sinks behind a closing low-pass for about a second (design-plan §10)
##   play  all off (low HP closes the music to 3 kHz and 2 dB on top of it)
func snapshot(name: StringName) -> void:
	if Game.quiet > 0:
		return
	if name in [&"pause", &"editor", &"map", &"reward", &"shop"]:
		name = &"menu"
	if name == _snap:
		return
	_snap = name
	_retarget()


func current_snapshot() -> StringName:
	return _snap


## Kept for callers of v1: the death sweep is the "dead" snapshot.
func death_sweep() -> void:
	snapshot(&"dead")


## The low-pass, music and ambience levels the snapshot (and low HP) want, tweened there.
func _retarget() -> void:
	var lp := 20000.0
	var mdb := 0.0
	var adb := 0.0
	var t := 0.4
	match _snap:
		&"menu":
			lp = 1200.0
			mdb = -4.0
			adb = -8.0
			t = 0.25
		&"dead":
			lp = 500.0
			adb = -12.0
			t = 1.0
			_lp_hz = minf(_lp_hz, 16000.0)
		_:
			if _low:
				lp = 3000.0
				mdb = -2.0
	if _snap_tw:
		_snap_tw.kill()
	if not is_inside_tree():
		_lp_hz = lp
		_snap_music_db = mdb
		_snap_amb_db = adb
		return
	_snap_tw = create_tween().set_parallel(true)
	var lpt := _snap_tw.tween_property(self, "_lp_hz", lp, t)
	if _snap == &"dead":
		lpt.set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_EXPO)
	_snap_tw.tween_property(self, "_snap_music_db", mdb, t)
	_snap_tw.tween_property(self, "_snap_amb_db", adb, t)


## The player's HP as a fraction, every tick of play. Under LOW_HP a heartbeat plays and the
## music closes a little; it lifts a moment after the calls stop (a menu, death, the title).
func player_hp(frac: float) -> void:
	if Game.quiet > 0:
		return
	_hp_frac = frac
	_hp_seen = Time.get_ticks_msec()


func low_hp_active() -> bool:
	return _low


## World hit-stop: telegraphs hold for its length (so they still end on release), and one of
## DUCK_MIN_T or longer pulls the SFX bus down so the impact lands in a gap (sound-v2 §6.3).
func on_hitstop(t: float) -> void:
	if Game.quiet > 0:
		return
	var until := Time.get_ticks_msec() + int(t * 1000.0)
	_tele_hold_until = maxi(_tele_hold_until, until)
	if t >= DUCK_MIN_T:
		_duck_until = maxi(_duck_until, until)


func _update_state(dt: float) -> void:
	var now := Time.get_ticks_msec()
	# low HP: the heartbeat and the music's filter
	var low := heartbeat_on and sound_on and _snap == &"play" and _hp_frac < LOW_HP and now - _hp_seen < 300
	if low != _low:
		_low = low
		_retarget()
		_hb_t = 0.0
	if _low:
		_hb_t -= dt
		if _hb_t <= 0.0:
			_hb_t = lerpf(0.9, 1.2, clampf(_hp_frac / LOW_HP, 0.0, 1.0))
			_request("low_hp", Vector2.INF, 0.0, 0, 0.0, 0.0, -1)
	# telegraphs hold while the world does (hit-stop, a menu over play)
	var hold := _snap == &"menu" or now < _tele_hold_until
	if hold != _tele_held:
		_tele_held = hold
		for v: Voice in _pools.get("crit", []):
			if v.cue and v.cue.group == "tele" and v.busy(now):
				v.p2.stream_paused = hold
				if hold:
					v.held_left = maxi(0, v.t1 - now)
				else:
					v.t1 = now + v.held_left
					v.held_left = -1
	# the hit-stop duck: down at once, back over DUCK_RELEASE
	var want := DUCK_DB if now < _duck_until else 0.0
	_duck_db = want if want < _duck_db else move_toward(_duck_db, 0.0, -DUCK_DB * dt / DUCK_RELEASE)
	# the stinger duck: down over 80 ms, back over 0.4 s
	var sw := STING_DUCK_DB if now < _sting_until else 0.0
	_sting_db = move_toward(_sting_db, sw, (-STING_DUCK_DB / 0.08 if sw < _sting_db else -STING_DUCK_DB / 0.4) * dt)
	# the Glitch bus's distortion runs only while a copied spell plays
	var g := now < _glitch_until
	if g != _glitch_on:
		_glitch_on = g
		AudioServer.set_bus_effect_enabled(AudioServer.get_bus_index("Glitch"), 0, g)
	# the snapshot's values, written only when they change
	var cur := Vector4(_lp_hz, _snap_music_db + _sting_db + voice_db, _snap_amb_db, _duck_db)
	if cur != _applied:
		_applied = cur
		var mb := AudioServer.get_bus_index("Music")
		_lowpass.cutoff_hz = _lp_hz
		AudioServer.set_bus_effect_enabled(mb, 1, _lp_hz < 18000.0)
		AudioServer.set_bus_volume_db(mb, cur.y)
		AudioServer.set_bus_volume_db(AudioServer.get_bus_index("Ambience"), _snap_amb_db)
		AudioServer.set_bus_volume_db(AudioServer.get_bus_index("SFX"), _duck_db)


# ------------------------------------------------------------------ stingers and ambience

var _stings: Array[AudioStreamPlayer] = []
var _sting_prio: Array[int] = []
var _sting_until := 0
var _sting_db := 0.0
var _last_sting := ""
var _last_sting_ms := -99999


## A stinger (clear, reward, boss, boss_down, world, victory, defeat, glitch) on the Sting bus;
## the music ducks 6 dB under it. The area's own version plays when there is one
## (sting_clear_grove): the current track's, or `track`'s when given (sting("world", false,
## "kernel") before the Kernel's music starts). `quantize` lands it on the music's next beat.
## Two voices, by STING_PRIO.
func sting(name: String, quantize := false, track := "") -> void:
	if not music_on or Game.quiet > 0 or not is_inside_tree():
		return
	_setup()
	var tk := track if track != "" else _track
	var s := stream("sting_%s_%s" % [name, tk]) if tk != "" else null
	if s == null:
		s = stream("sting_" + name)
	if s == null:
		return
	var prio := int(STING_PRIO.get(name, 1))
	var k := 0 if not _stings[0].playing else (1 if not _stings[1].playing else (0 if _sting_prio[0] <= _sting_prio[1] else 1))
	if _stings[k].playing and _sting_prio[k] > prio:
		return
	var p := _stings[k]
	_sting_prio[k] = prio
	p.stream = s
	_last_sting = name
	_last_sting_ms = Time.get_ticks_msec()
	var wait := float(bar_clock().get("to_next_beat", 0.0)) if quantize else 0.0
	_sting_until = Time.get_ticks_msec() + int((wait + s.get_length()) * 1000.0)
	if wait > 0.03:
		create_tween().tween_callback(p.play).set_delay(wait)
	else:
		p.play()


func _on_room_cleared() -> void:
	# a boss room's clear is its boss_down stinger (world asks for it just before)
	if _last_sting == "boss_down" and Time.get_ticks_msec() - _last_sting_ms < 1500:
		return
	sting("clear", true)


## The area's ambience bed (cellar | grove | foundry | kernel | ring, "" for none), a quiet loop on
## its own bus under the music, with spots now and then. Crossfades like the music.
var _amb: AudioStreamPlayer
var _amb_name := ""
var _amb_tw: Tween
var _spot: AudioStreamPlayer2D
var _spot_t := 4.0


func ambience(area: String, fade := 1.2) -> void:
	if area == _amb_name or Game.quiet > 0 or not is_inside_tree():
		return
	_amb_name = area
	if _amb == null:
		_amb = AudioStreamPlayer.new()
		_amb.bus = "Ambience"
		add_child(_amb)
	if _amb_tw:
		_amb_tw.kill()
	_amb_tw = create_tween()
	if area == "":
		_amb_tw.tween_property(_amb, "volume_db", -80.0, fade)
		_amb_tw.tween_callback(_amb.stop)
		return
	var s := stream("music_amb_" + area)
	if s == null:
		return
	_amb.stream = s
	_amb.volume_db = -60.0
	_amb.play()
	_amb_tw.tween_property(_amb, "volume_db", AMB_DB, fade)


func ambience_name() -> String:
	return _amb_name


func _update_spots(dt: float) -> void:
	if _amb_name == "" or not sound_on or not AMB_SPOTS.has(_amb_name):
		return
	_spot_t -= dt
	if _spot_t > 0.0:
		return
	_spot_t = _rng.randf_range(3.0, 9.0)
	var ids: Array = AMB_SPOTS[_amb_name]
	var c := _cue(String(ids[_rng.randi() % ids.size()]))
	if c.streams.is_empty():
		return
	var half := get_viewport().get_visible_rect().size.x * 0.5 if get_viewport() else 240.0
	_spot.stream = c.streams[_pick(c)]
	_spot.global_position = _ear() + Vector2(_rng.randf_range(-0.7, 0.7) * half, 0.0)
	_spot.play()


