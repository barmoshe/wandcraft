var _music_a: AudioStreamPlayer
var _music_b: AudioStreamPlayer
var _cur: AudioStreamPlayer        # the player carrying the current track (null: silence)
var _track := ""
var _tween: Tween
var _t_acc := 0.0                  # the clock of a v1 intro track (its player cannot report it)
var _layers: Dictionary = {}       # layer name -> [AudioStreamSynchronized, index]
var _layer_on: Dictionary = {}
var _layer_tw: Dictionary = {}
var _layer_at: Dictionary = {}     # layer name -> the music position its last switch lands on
var _built: Dictionary = {}        # track -> AudioStream
var _built_layers: Dictionary = {} # track -> {layer name: stem index}
var _int := 0
var _int_want := 0
var _int_low_t := 0.0


## A plain file from res://assets/audio (cached; null when missing).
func stream(name: String) -> AudioStream:
	if not _streams.has(name):
		var path := "res://assets/audio/%s.wav" % name
		_streams[name] = load(path) if ResourceLoader.exists(path) else null
	return _streams[name]


static func has_track(track: String) -> bool:
	return TRACKS.has(track)


## True when a track's first stem is on disk (the mini track waits for its files).
static func track_ready(track: String) -> bool:
	return TRACKS.has(track) and ResourceLoader.exists("res://assets/audio/%s.wav" % TRACKS[track]["stems"][0])


static func music_v2() -> bool:
	return ResourceLoader.exists("res://assets/audio/%s.wav" % V2_MUSIC_MARKER)


## A track's tempo: the spec's, or the old one until the v2 music lands.
static func track_bpm(track: String) -> float:
	if not music_v2() and V1_BPM.has(track):
		return float(V1_BPM[track])
	return float((TRACKS[track] as Dictionary).get("bpm", 120.0))


## The stream for a track, built once: a single loop, or a synchronized set of the stems that
## exist (the v1 boss: its old intro handing over to that set).
func track_stream(track: String) -> AudioStream:
	if _built.has(track):
		return _built[track]
	var def: Dictionary = TRACKS[track]
	var stems: Array = def["stems"]
	var names: Array = def.get("layers", [])
	var have: Array[AudioStream] = []
	var map := {}
	for i in stems.size():
		var st := stream(stems[i])
		if st:
			if i < names.size() and names[i] != "":
				map[names[i]] = have.size()
			have.append(st)
	var s: AudioStream = null
	if have.size() == 1 and names.is_empty():
		s = have[0]
	elif not have.is_empty():
		var sync := AudioStreamSynchronized.new()
		sync.stream_count = have.size()
		for i in have.size():
			sync.set_sync_stream(i, have[i])
			sync.set_sync_stream_volume(i, 0.0 if i == 0 else LAYER_OFF_DB)
		s = sync
		if def.has("v1_intro") and not music_v2() and stream(def["v1_intro"]) != null:
			var inter := AudioStreamInteractive.new()
			inter.clip_count = 2
			inter.set_clip_name(0, &"intro")
			inter.set_clip_stream(0, stream(def["v1_intro"]))
			inter.set_clip_auto_advance(0, AudioStreamInteractive.AUTO_ADVANCE_ENABLED)
			inter.set_clip_auto_advance_next_clip(0, 1)
			inter.set_clip_name(1, &"loop")
			inter.set_clip_stream(1, sync)
			inter.initial_clip = 0
			s = inter
	_built[track] = s
	_built_layers[track] = map
	return s


## Crossfades to a music track: title | shop | cellar | grove | foundry | kernel | mini | boss | ""
## (silence). The same track keeps playing (a new room of the same area does not restart it).
## Every optional layer starts off. The title and silence also fade the ambience out.
func music(track: String, fade := 0.8) -> void:
	if track == "" or track == "title":
		ambience("", fade)
	if track == _track:
		return
	_setup()
	_track = track
	for k: String in _layer_tw:
		var old: Tween = _layer_tw[k]
		if old:
			old.kill()
	_layer_tw.clear()
	_layers.clear()
	_layer_on.clear()
	_layer_at.clear()
	_int = 0
	_int_want = 0
	_int_low_t = 0.0
	var s: AudioStream = track_stream(track) if TRACKS.has(track) else null
	if s:
		# the layer bookkeeping does not need a running tree (the tests check it headless)
		var sync: AudioStreamSynchronized = s if s is AudioStreamSynchronized else (
			(s as AudioStreamInteractive).get_clip_stream(1) if s is AudioStreamInteractive else null)
		if sync:
			for i in sync.stream_count:
				sync.set_sync_stream_volume(i, 0.0 if i == 0 else LAYER_OFF_DB)
			var map: Dictionary = _built_layers.get(track, {})
			for name: String in map:
				_layers[name] = [sync, int(map[name])]
	if not is_inside_tree():
		return
	var incoming := _music_b if _cur == _music_a else _music_a
	if _tween:
		_tween.kill()
	_tween = create_tween().set_parallel(true)
	# everything that is not the new track fades out (one player may still be fading from before)
	for p: AudioStreamPlayer in [_music_a, _music_b]:
		if p.playing and (p != incoming or s == null):
			_tween.tween_property(p, "volume_db", -80.0, fade)
			_tween.tween_callback(func() -> void:
				if p != _cur:
					p.stop()).set_delay(fade)
	if s:
		incoming.stream = s
		incoming.volume_db = -40.0
		incoming.play()
		_tween.tween_property(incoming, "volume_db", MUSIC_DB, fade)
	_cur = incoming if s else null
	_t_acc = 0.0


func current_track() -> String:
	return _track


## Where the music is, in seconds of its own time: the mix head. A layer's volume change takes
## effect at the mix head, so output latency cancels out of the scheduling (the heard layer and
## the heard bar are late by the same amount). Stems report their position; the v1 boss intro
## cannot, so its time is counted by frames while it plays (frames stop with a hidden page).
func music_pos() -> float:
	if _cur == null or not _cur.playing:
		return 0.0
	if _cur.stream is AudioStreamInteractive:
		return _t_acc
	return _cur.get_playback_position() + AudioServer.get_time_since_last_mix()


## The bar clock of the current track: {pos, beat, bar, to_next_beat, to_next_bar} in seconds;
## {} with no track playing. Intros are whole bars, so the phase is position mod bar.
func bar_clock() -> Dictionary:
	if _cur == null or not TRACKS.has(_track):
		return {}
	var beat := 60.0 / track_bpm(_track)
	var bar := beat * float((TRACKS[_track] as Dictionary).get("beats_per_bar", 4))
	var pos := music_pos()
	return {"pos": pos, "beat": beat, "bar": bar, "to_next_beat": beat - fposmod(pos, beat), "to_next_bar": bar - fposmod(pos, bar)}


## Turns an optional layer of the playing track on or off (drums, lead, p2, p3). The switch
## lands on the music's next bar with a 60 ms fade (the drums leave over a whole bar). Returns
## how long it waits.
func layer(name: String, on: bool) -> float:
	if not _layers.has(name) or layer_on(name) == on:
		return 0.0
	_layer_on[name] = on
	var ref: Array = _layers[name]
	var sync: AudioStreamSynchronized = ref[0]
	var i: int = ref[1]
	if _layer_tw.has(name) and _layer_tw[name]:
		(_layer_tw[name] as Tween).kill()
	var to := 0.0 if on else LAYER_OFF_DB
	var clk := bar_clock()
	if not is_inside_tree() or clk.is_empty():
		sync.set_sync_stream_volume(i, to)
		return 0.0
	var wait := float(clk["to_next_bar"])
	var fade := float(LAYER_FADE.get("%s_%s" % [name, "on" if on else "off"], LAYER_FADE_DEFAULT))
	if fade < 0.0:
		fade = -fade * float(clk["bar"])
	_layer_at[name] = float(clk["pos"]) + wait
	var tw := create_tween()
	tw.tween_interval(wait)
	tw.tween_method(func(db: float) -> void: sync.set_sync_stream_volume(i, db),
		sync.get_sync_stream_volume(i), to, maxf(0.01, fade))
	_layer_tw[name] = tw
	return wait


func layer_on(name: String) -> bool:
	return bool(_layer_on.get(name, false))


## The music position a layer's last switch lands on (tests).
func layer_due(name: String) -> float:
	return float(_layer_at.get(name, -1.0))


## How hard the music plays (sound-v2 §5.2): 0 base, 1 + drums, 2 + lead. Up at once (on the
## next bar); down only after it has wanted to for INTENSITY_HOLD seconds, unless `now` (a
## room clear).
func intensity(level: int, now := false) -> void:
	_int_want = level
	if level > _int or (now and level < _int):
		_set_intensity(level)


func intensity_level() -> int:
	return _int


func _set_intensity(level: int) -> void:
	_int = level
	_int_low_t = 0.0
	layer("drums", level >= 1)
	layer("lead", level >= 2)


func _update_intensity(dt: float) -> void:
	if _int_want < _int:
		_int_low_t += dt
		if _int_low_t >= INTENSITY_HOLD:
			_set_intensity(_int_want)
	else:
		_int_low_t = 0.0


# ------------------------------------------------------------------ the frame

## Web: publishes the Music bus's peak (dB) to the page twice a second, so tools/webtest.sh can
## check the music really plays (window.wandcraftMusicPeak), not just that some sound does.
var _pub_t := 0.0


func _process(dt: float) -> void:
	if _cur and _cur.playing:
		_t_acc += dt
	_update_intensity(dt)
	_update_state(dt)
	_update_spots(dt)
	flush()
	if not OS.has_feature("web"):
		return
	_pub_t -= dt
	if _pub_t > 0.0:
		return
	_pub_t = 0.5
	var bus := AudioServer.get_bus_index("Music")
	var db := maxf(AudioServer.get_bus_peak_volume_left_db(bus, 0), -200.0)
	JavaScriptBridge.eval("window.wandcraftMusicPeak = %.1f; window.wandcraftMusicTrack = '%s';" % [db, _track], true)
