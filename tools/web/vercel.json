{
  "headers": [
    { "source": "/(.*)\\.wasm", "headers": [ { "key": "Content-Type", "value": "application/wasm" }, { "key": "Cache-Control", "value": "public, max-age=600, must-revalidate" } ] },
    { "source": "/(.*)\\.pck", "headers": [ { "key": "Content-Type", "value": "application/octet-stream" }, { "key": "Cache-Control", "value": "public, max-age=600, must-revalidate" } ] }
  ]
}
